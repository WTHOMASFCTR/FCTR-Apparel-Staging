{% doc %}
  @prompt
    I want a gallery section where images can be horizontal, square, portrait, or adapt to image size. I want there to be the option to have 2-5 images. I want the images to be able to link so when someone clicks the image it takes them to the link. I want the ability to put a gallery title in and be able to have the title justified to the left, center, or right. , The font should match the theme settings. Make the title an H2, Each image needs an H4. I have the option to have the text on the image or have underneath for the block. I also want the option to add an overlay with a selected color to each image.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gallery-{{ ai_gen_id }} {
    width: 100%;
    padding: 40px 20px;
  }

  .ai-gallery-title-{{ ai_gen_id }} {
    margin: 0 0 30px;
    color: {{ block.settings.title_color }};
    text-align: {{ block.settings.title_alignment }};
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-weight: {{ settings.heading_font.weight }};
    font-style: {{ settings.heading_font.style }};
    text-transform: {{ settings.heading_text_transform }};
  }

  .ai-gallery-grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.image_spacing }}px;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .ai-gallery-grid-{{ ai_gen_id }}--2-images {
    grid-template-columns: repeat(2, 1fr);
  }

  .ai-gallery-grid-{{ ai_gen_id }}--3-images {
    grid-template-columns: repeat(3, 1fr);
  }

  .ai-gallery-grid-{{ ai_gen_id }}--4-images {
    grid-template-columns: repeat(4, 1fr);
  }

  .ai-gallery-grid-{{ ai_gen_id }}--5-images {
    grid-template-columns: repeat(5, 1fr);
  }

  .ai-gallery-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-gallery-item-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 0.3s ease;
    text-decoration: none;
  }

  .ai-gallery-item-link-{{ ai_gen_id }}:hover {
    transform: scale(1.02);
  }

  .ai-gallery-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-gallery-item-{{ ai_gen_id }}--horizontal .ai-gallery-image-{{ ai_gen_id }} {
    aspect-ratio: 16 / 9;
  }

  .ai-gallery-item-{{ ai_gen_id }}--square .ai-gallery-image-{{ ai_gen_id }} {
    aspect-ratio: 1 / 1;
  }

  .ai-gallery-item-{{ ai_gen_id }}--portrait .ai-gallery-image-{{ ai_gen_id }} {
    aspect-ratio: 3 / 4;
  }

  .ai-gallery-item-{{ ai_gen_id }}--adapt .ai-gallery-image-{{ ai_gen_id }} {
    aspect-ratio: auto;
  }

  .ai-gallery-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-gallery-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .ai-gallery-caption-on-image-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    z-index: 1;
  }

  .ai-gallery-caption-underneath-{{ ai_gen_id }} {
    padding: 15px 0 0;
  }

  .ai-gallery-caption-text-{{ ai_gen_id }} {
    margin: 0;
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-weight: {{ settings.heading_font.weight }};
    font-style: {{ settings.heading_font.style }};
    text-transform: {{ settings.heading_text_transform }};
  }

  .ai-gallery-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  @media screen and (max-width: 989px) {
    .ai-gallery-grid-{{ ai_gen_id }}--4-images,
    .ai-gallery-grid-{{ ai_gen_id }}--5-images {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-gallery-grid-{{ ai_gen_id }}--3-images,
    .ai-gallery-grid-{{ ai_gen_id }}--4-images,
    .ai-gallery-grid-{{ ai_gen_id }}--5-images {
      grid-template-columns: repeat(1, 1fr);
    }

    .ai-gallery-{{ ai_gen_id }} {
      padding: 30px 15px;
    }

    .ai-gallery-title-{{ ai_gen_id }} {
      margin-bottom: 20px;
    }

    .ai-gallery-caption-on-image-{{ ai_gen_id }} {
      padding: 15px;
    }
  }
{% endstyle %}

<div class="ai-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.gallery_title != blank %}
    <h2 class="ai-gallery-title-{{ ai_gen_id }}">{{ block.settings.gallery_title }}</h2>
  {% endif %}

  {% liquid
    assign active_images = 0
    for i in (1..5)
      assign image_key = 'image_' | append: i
      if block.settings[image_key] != blank
        assign active_images = active_images | plus: 1
      endif
    endfor
  %}

  <div class="ai-gallery-grid-{{ ai_gen_id }} ai-gallery-grid-{{ ai_gen_id }}--{{ active_images }}-images">
    {% for i in (1..5) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign link_key = 'image_' | append: i | append: '_link'
        assign ratio_key = 'image_' | append: i | append: '_ratio'
        assign caption_key = 'image_' | append: i | append: '_caption'
        assign overlay_key = 'image_' | append: i | append: '_overlay_color'
        assign overlay_opacity_key = 'image_' | append: i | append: '_overlay_opacity'
        assign caption_color_key = 'image_' | append: i | append: '_caption_color'
        
        assign current_image = block.settings[image_key]
        assign current_link = block.settings[link_key]
        assign current_ratio = block.settings[ratio_key]
        assign current_caption = block.settings[caption_key]
        assign current_overlay = block.settings[overlay_key]
        assign current_overlay_opacity = block.settings[overlay_opacity_key]
        assign current_caption_color = block.settings[caption_color_key]
      %}

      {% if current_image != blank %}
        <div class="ai-gallery-item-{{ ai_gen_id }} ai-gallery-item-{{ ai_gen_id }}--{{ current_ratio }}">
          {% if current_link != blank %}
            <a href="{{ current_link }}" class="ai-gallery-item-link-{{ ai_gen_id }}">
          {% endif %}

          <div class="ai-gallery-image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ current_image | image_url: width: 1200 }}"
              alt="{{ current_image.alt | escape }}"
              loading="lazy"
              width="{{ current_image.width }}"
              height="{{ current_image.height }}"
              class="ai-gallery-image-{{ ai_gen_id }}"
            >

            {% if current_overlay != blank %}
              <div
                class="ai-gallery-overlay-{{ ai_gen_id }}"
                style="background-color: {{ current_overlay }}; opacity: {{ current_overlay_opacity }};"
              ></div>
            {% endif %}

            {% if block.settings.caption_position == 'on_image' and current_caption != blank %}
              <div class="ai-gallery-caption-on-image-{{ ai_gen_id }}">
                <h4 class="ai-gallery-caption-text-{{ ai_gen_id }}" style="color: {{ current_caption_color }};">
                  {{ current_caption }}
                </h4>
              </div>
            {% endif %}
          </div>

          {% if block.settings.caption_position == 'underneath' and current_caption != blank %}
            <div class="ai-gallery-caption-underneath-{{ ai_gen_id }}">
              <h4 class="ai-gallery-caption-text-{{ ai_gen_id }}" style="color: {{ current_caption_color }};">
                {{ current_caption }}
              </h4>
            </div>
          {% endif %}

          {% if current_link != blank %}
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

