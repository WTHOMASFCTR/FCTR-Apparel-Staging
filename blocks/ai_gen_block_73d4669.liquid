          "value": "stack",
          "label": "Stack"
        },
        {
          "value": "carousel",
          "label": "Scrollable carousel"
        }
      ],
      "default": "stack"
    },
    {
      "type": "header",
      "content": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption_1",
      "label": "Caption"
    },
    {
