{% doc %}
  Renders a collapsible team quantity table alongside the existing product form.
  @param {product} product - The current product.
  @param {string} product_form_id - The existing product form identifier.
  @param {block} block - The team orders block.
{% enddoc %}
{%- liquid
  assign color_option = nil
  assign color_index = 0
  assign color_names = 'general.label.color' | t | downcase | replace: ', ', ',' | split: ','
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if color_names contains option_name
      assign color_option = option
      assign color_index = forloop.index0
    endif
  endfor
-%}
<fctr-team-orders
  class="fctr-team-orders"
  data-form-id="{{ product_form_id | escape }}"
  data-cart-url="{{ routes.cart_url }}"
  data-add-url="{{ routes.cart_add_url }}.js"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-locale="{{ request.locale.iso_code }}"
  data-empty-message="{{ 'fctr_team_orders.empty' | t | escape }}"
  data-invalid-message="{{ 'fctr_team_orders.invalid' | t | escape }}"
  data-failed-message="{{ 'fctr_team_orders.failed' | t | escape }}"
  data-uncertain-message="{{ 'fctr_team_orders.uncertain' | t | escape }}"
  data-file-message="{{ 'fctr_team_orders.file' | t | escape }}"
  data-loading-message="{{ 'fctr_team_orders.loading' | t | escape }}"
  data-success-message="{{ 'fctr_team_orders.success' | t | escape }}"
  data-properties-message="{{ 'fctr_team_orders.properties' | t | escape }}"
  {{ block.shopify_attributes }}
>
  <details class="fctr-team-orders__details">
    <summary class="fctr-team-orders__tab">
      <span>{{ 'fctr_team_orders.title' | t }}</span>
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 8 5 5 5-5" stroke="currentColor" stroke-width="1.5" /></svg>
    </summary>
    <div class="fctr-team-orders__panel">
      <p class="fctr-team-orders__intro">{{ 'fctr_team_orders.intro' | t }}</p>
      <noscript><p>{{ 'fctr_team_orders.no_script' | t }}</p></noscript>
      {%- paginate product.variants by 250 -%}
        {%- if paginate.pages > 1 -%}
          <p>{{ 'fctr_team_orders.too_many' | t }}</p>
        {%- else -%}
          {%- if color_option != nil -%}
            <label class="fctr-team-orders__filter-label" for="TeamColor-{{ block.id }}">{{ color_option.name | escape }}</label>
            <select id="TeamColor-{{ block.id }}" data-team-color class="fctr-team-orders__filter">
              {%- for value in color_option.values -%}
                <option value="{{ value | escape }}" {% if value == color_option.selected_value %}selected{% endif %}>{{ value | escape }}</option>
              {%- endfor -%}
            </select>
          {%- endif -%}
          <div class="fctr-team-orders__table-wrap">
            <table class="fctr-team-orders__table">
              <caption class="visually-hidden">{{ 'fctr_team_orders.caption' | t: product: product.title }}</caption>
              <thead><tr>
                <th scope="col">{% if product.options.size == 1 %}{{ product.options.first | escape }}{% else %}{{ 'fctr_team_orders.variant' | t }}{% endif %}</th>
                <th scope="col">{{ 'fctr_team_orders.each' | t }}</th>
                <th scope="col">{{ 'fctr_team_orders.quantity' | t }}</th>
              </tr></thead>
              <tbody>
                {%- for variant in product.variants -%}
                  <tr data-team-row {% if color_option != nil %}data-color="{{ variant.options[color_index] | escape }}"{% endif %} data-variant-id="{{ variant.id }}" data-price="{{ variant.price }}" data-min="{{ variant.quantity_rule.min | default: 1 }}" data-increment="{{ variant.quantity_rule.increment | default: 1 }}" {% if variant.quantity_rule.max != nil %}data-max="{{ variant.quantity_rule.max }}"{% endif %}>
                    <th scope="row">
                      <label for="TeamQuantity-{{ block.id }}-{{ variant.id }}">{{ variant.title | escape }}</label>
                      {%- unless variant.available -%}<span class="fctr-team-orders__unavailable">{{ 'fctr_team_orders.sold_out' | t }}</span>{%- endunless -%}
                    </th>
                    <td>{{ variant.price | money }}</td>
                    <td><input id="TeamQuantity-{{ block.id }}-{{ variant.id }}" data-team-quantity type="number" inputmode="numeric" min="0" step="1" value="0" autocomplete="off" aria-label="{{ 'fctr_team_orders.quantity_for' | t: variant: variant.title | escape }}" {% unless variant.available %}disabled{% endunless %}></td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          <div class="fctr-team-orders__totals" aria-live="polite" aria-atomic="true">
            <span>{{ 'fctr_team_orders.items' | t }} <strong data-team-count>0</strong></span>
            <span>{{ 'fctr_team_orders.subtotal' | t }} <strong data-team-subtotal>{{ 0 | money }}</strong></span>
          </div>
          <p class="fctr-team-orders__note">{{ 'fctr_team_orders.note' | t }}</p>
          <button type="button" class="button button--primary button--full fctr-team-orders__add" data-team-add disabled>{{ 'fctr_team_orders.add' | t }}</button>
          <p class="fctr-team-orders__message" data-team-message role="status" aria-live="polite" tabindex="-1" hidden></p>
          <a class="link fctr-team-orders__cart" href="{{ routes.cart_url }}" data-team-cart hidden>{{ 'fctr_team_orders.view_cart' | t }}</a>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </details>
</fctr-team-orders>

{% stylesheet %}
  .fctr-team-orders { display: block; margin: 18px 0 24px; }
  .fctr-team-orders__details { border: 1px solid rgba(var(--text-color), .2); border-radius: 6px; overflow: hidden; }
  .fctr-team-orders__tab { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 52px; padding: 14px 18px; cursor: pointer; list-style: none; font-family: var(--heading-font-family); font-weight: 700; font-size: 14px; letter-spacing: .04em; }
  .fctr-team-orders__tab::-webkit-details-marker { display: none; }
  .fctr-team-orders__details[open] .fctr-team-orders__tab { border-bottom: 1px solid rgba(var(--text-color), .15); }
  .fctr-team-orders__details[open] .fctr-team-orders__tab svg { transform: rotate(180deg); }
  .fctr-team-orders__panel { padding: 0 18px 18px; }
  .fctr-team-orders__intro { margin: 16px 0; font-size: 14px; line-height: 1.5; }
  .fctr-team-orders__filter-label { display: block; font-size: 12px; margin-bottom: 6px; font-weight: 600; }
  .fctr-team-orders__filter { width: 100%; min-height: 44px; padding: 8px 12px; border: 1px solid rgba(var(--text-color), .3); border-radius: 3px; color: inherit; background: rgb(var(--background)); margin-bottom: 12px; font-size: 16px; }
  .fctr-team-orders__table-wrap { overflow-x: auto; }
  .fctr-team-orders__table { width: 100%; border-collapse: collapse; font-size: 14px; text-align: left; }
  .fctr-team-orders__table th, .fctr-team-orders__table td { padding: 11px 8px; border-bottom: 1px solid rgba(var(--text-color), .12); vertical-align: middle; }
  .fctr-team-orders__table thead th { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .fctr-team-orders__table th:first-child { padding-left: 0; }
  .fctr-team-orders__table th:last-child, .fctr-team-orders__table td:last-child { text-align: right; padding-right: 0; }
  .fctr-team-orders__table tbody th { font-weight: 500; overflow-wrap: anywhere; }
  .fctr-team-orders__table input { box-sizing: border-box; width: 72px; min-height: 44px; padding: 8px; border: 1px solid rgba(var(--text-color), .3); border-radius: 3px; color: inherit; background: rgb(var(--background)); text-align: center; font-size: 16px; }
  .fctr-team-orders__table input:disabled { opacity: .4; cursor: not-allowed; }
  .fctr-team-orders__unavailable { display: block; font-size: 11px; opacity: .65; }
  .fctr-team-orders__totals { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 18px; font-size: 14px; }
  .fctr-team-orders__note { margin: 8px 0 16px; font-size: 12px; line-height: 1.5; opacity: .75; }
  .fctr-team-orders__message { margin: 14px 0 0; font-size: 14px; line-height: 1.5; }
  .fctr-team-orders__cart { display: inline-block; margin-top: 10px; font-size: 14px; }
  .fctr-team-orders [hidden] { display: none !important; }
  .fctr-team-orders__tab:focus-visible, .fctr-team-orders input:focus-visible, .fctr-team-orders button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media (max-width: 480px) { .fctr-team-orders__panel { padding-inline: 12px; } .fctr-team-orders__table th, .fctr-team-orders__table td { padding-inline: 5px; } .fctr-team-orders__table input { width: 64px; } }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('fctr-team-orders')) {
    customElements.define('fctr-team-orders', class extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;
        this.rows = Array.from(this.querySelectorAll('[data-team-row]'));
        this.addButton = this.querySelector('[data-team-add]');
        if (!this.addButton) return;
        this.buttonLabel = this.addButton.textContent;
        this.message = this.querySelector('[data-team-message]');
        this.cartLink = this.querySelector('[data-team-cart]');
        this.colorFilter = this.querySelector('[data-team-color]');
        try { this.money = new Intl.NumberFormat(this.dataset.locale, { style: 'currency', currency: this.dataset.currency }); }
        catch { this.money = new Intl.NumberFormat('en-US', { style: 'currency', currency: this.dataset.currency }); }
        this.addEventListener('input', () => { this.message.hidden = true; this.update(); });
        if (this.colorFilter) this.colorFilter.addEventListener('change', () => this.filterRows());
        this.addButton.addEventListener('click', () => this.addOrder());
        this.filterRows();
        this.update();
      }

      filterRows() {
        if (!this.colorFilter) return;
        this.rows.forEach(row => { row.hidden = row.dataset.color !== this.colorFilter.value; });
      }

      selection() {
        return this.rows.map(row => ({ row, input: row.querySelector('input'), quantity: Number(row.querySelector('input').value) }));
      }

      update() {
        const entries = this.selection();
        let count = 0;
        let subtotal = 0;
        entries.forEach(({ row, input, quantity }) => {
          input.setCustomValidity('');
          const valid = Number.isSafeInteger(quantity) && quantity >= 0 && (quantity === 0 || (quantity >= Number(row.dataset.min) && quantity % Number(row.dataset.increment) === 0 && (!row.dataset.max || quantity <= Number(row.dataset.max))));
          if (!valid && !input.disabled) input.setCustomValidity(this.dataset.invalidMessage);
          if (valid && !input.disabled) { count += quantity; subtotal += quantity * Number(row.dataset.price); }
        });
        this.querySelector('[data-team-count]').textContent = String(count);
        this.querySelector('[data-team-subtotal]').textContent = this.money.format(subtotal / 100);
        this.addButton.disabled = this.busy || this.locked || !entries.some(entry => entry.quantity !== 0 && !entry.input.disabled);
      }

      showMessage(text) {
        this.message.textContent = text;
        this.message.hidden = false;
        this.message.focus();
      }

      async addOrder() {
        if (this.busy || this.locked) return;
        this.update();
        for (const { input } of this.selection()) {
          if (!input.disabled && !input.reportValidity()) return;
        }
        const entries = this.selection().filter(entry => entry.quantity > 0 && !entry.input.disabled);
        if (!entries.length) { this.showMessage(this.dataset.emptyMessage); return; }
        const form = document.getElementById(this.dataset.formId);
        if (!form) { this.showMessage(this.dataset.failedMessage); return; }
        if (!form.reportValidity()) return;
        const formData = new FormData(form);
        const properties = {};
        for (const [name, value] of formData) {
          if (value instanceof File && value.size > 0) { this.showMessage(this.dataset.fileMessage); return; }
          const match = name.match(/^properties\[(.+)\]$/);
          if (match && typeof value === 'string') properties[match[1]] = value;
        }
        const sellingPlan = formData.get('selling_plan');
        const items = entries.map(({ row, quantity }) => {
          const item = { id: row.dataset.variantId, quantity, properties: { ...properties } };
          if (sellingPlan) item.selling_plan = sellingPlan;
          return item;
        });
        this.busy = true;
        this.addButton.textContent = this.dataset.loadingMessage;
        this.addButton.setAttribute('aria-busy', 'true');
        this.rows.forEach(row => { const input = row.querySelector('input'); input.readOnly = true; });
        this.update();
        let response;
        try {
          response = await fetch(this.dataset.addUrl, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items }) });
          const result = await response.json();
          if (!response.ok || result.status) {
            this.locked = true;
            this.cartLink.hidden = false;
            this.showMessage(this.dataset.uncertainMessage);
            return;
          }
          this.locked = true;
          this.cartLink.hidden = false;
          this.showMessage(this.dataset.successMessage);
          window.location.assign(this.dataset.cartUrl);
        } catch {
          this.locked = true;
          this.cartLink.hidden = false;
          this.showMessage(this.dataset.uncertainMessage);
        } finally {
          this.busy = false;
          this.addButton.textContent = this.buttonLabel;
          this.addButton.removeAttribute('aria-busy');
          this.rows.forEach(row => { row.querySelector('input').readOnly = false; });
          this.update();
        }
      }
    });
  }
{% endjavascript %}