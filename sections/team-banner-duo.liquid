{% comment %}
  Team Banner Duo (Nike two-up style) — Auto-Hide + Dynamic Metaobject + Width/Padding Controls
  -------------------------------------------------------------------------------------------
  - 2-up responsive banners (desktop), stacked (mobile)
  - Each banner supports static OR Team metaobject dynamic values via field keys
  - Entire section auto-hides if NO banners have any content (image/title/subtitle)
  - Adds editor controls for container width + padding
  - Adds image fit controls: cover / contain / fill / adapt
  - Uses sentinel defaults "none" so Shopify schema doesn't reject blanks
{% endcomment %}

{%- liquid
  assign team_obj = nil

  if team != blank
    assign team_obj = team
  elsif section.settings.team_metaobject != blank
    assign team_obj = section.settings.team_metaobject
  endif

  assign heading_clean = section.settings.heading | strip
  if heading_clean == 'none'
    assign heading_clean = ''
  endif

  assign has_content = false
-%}

{%- comment %}
  First pass: determine if ANY banner has displayable content.
  Content = image OR title OR subtitle (static OR dynamic).
{% endcomment %}
{%- for block in section.blocks -%}
  {%- liquid
    assign b_image = block.settings.image

    assign b_title = block.settings.title | strip
    if b_title == 'none'
      assign b_title = ''
    endif

    assign b_subtitle = block.settings.subtitle | strip
    if b_subtitle == 'none'
      assign b_subtitle = ''
    endif

    assign image_key = block.settings.team_image_field | strip
    if image_key == 'none'
      assign image_key = ''
    endif

    assign title_key = block.settings.team_title_field | strip
    if title_key == 'none'
      assign title_key = ''
    endif

    assign subtitle_key = block.settings.team_subtitle_field | strip
    if subtitle_key == 'none'
      assign subtitle_key = ''
    endif

    if b_image != blank or b_title != '' or b_subtitle != ''
      assign has_content = true
    endif

    if has_content == false and team_obj != blank and image_key != blank
      assign f = team_obj[image_key]
      if f != blank and f.value != blank
        assign has_content = true
      endif
    endif

    if has_content == false and team_obj != blank and title_key != blank
      assign tf = team_obj[title_key]
      if tf != blank and tf.value != blank
        assign has_content = true
      endif
    endif

    if has_content == false and team_obj != blank and subtitle_key != blank
      assign sf = team_obj[subtitle_key]
      if sf != blank and sf.value != blank
        assign has_content = true
      endif
    endif
  -%}
{%- endfor -%}

{%- if has_content -%}

{%- liquid
  assign is_full = false
  if section.settings.container_width == 'full'
    assign is_full = true
  endif
-%}

<section class="fctr-banner-duo" style="
  --fctr-overlay-color: {{ section.settings.overlay_color }};
  --fctr-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  --fctr-gap: {{ section.settings.gap }}px;
  --fctr-min-height: {{ section.settings.min_height }}px;
  --fctr-max-width: {{ section.settings.max_width }}px;
  --fctr-pad-x: {{ section.settings.padding_x }}px;
  --fctr-pad-top: {{ section.settings.padding_top }}px;
  --fctr-pad-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="fctr-banner-duo__outer">
    <div class="fctr-banner-duo__inner {% unless is_full %}fctr-banner-duo__inner--contained{% endunless %}">
      {%- if heading_clean != blank -%}
        <h2 class="fctr-banner-duo__heading">{{ heading_clean }}</h2>
      {%- endif -%}

      <div class="fctr-banner-duo__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign image = block.settings.image

            assign title = block.settings.title | strip
            if title == 'none'
              assign title = ''
            endif

            assign subtitle = block.settings.subtitle | strip
            if subtitle == 'none'
              assign subtitle = ''
            endif

            assign link = block.settings.link

            assign image_key = block.settings.team_image_field | strip
            if image_key == 'none'
              assign image_key = ''
            endif

            assign title_key = block.settings.team_title_field | strip
            if title_key == 'none'
              assign title_key = ''
            endif

            assign subtitle_key = block.settings.team_subtitle_field | strip
            if subtitle_key == 'none'
              assign subtitle_key = ''
            endif

            assign link_key = block.settings.team_link_field | strip
            if link_key == 'none'
              assign link_key = ''
            endif

            if image == blank and team_obj != blank and image_key != blank
              assign field = team_obj[image_key]
              if field != blank and field.value != blank
                assign image = field.value
              endif
            endif

            if title == '' and team_obj != blank and title_key != blank
              assign tfield = team_obj[title_key]
              if tfield != blank and tfield.value != blank
                assign title = tfield.value | strip
              endif
            endif

            if subtitle == '' and team_obj != blank and subtitle_key != blank
              assign sfield = team_obj[subtitle_key]
              if sfield != blank and sfield.value != blank
                assign subtitle = sfield.value | strip
              endif
            endif

            if link == blank and team_obj != blank and link_key != blank
              assign lfield = team_obj[link_key]
              if lfield != blank and lfield.value != blank
                assign link = lfield.value
              endif
            endif

            assign banner_has_content = false
            if image != blank or title != '' or subtitle != ''
              assign banner_has_content = true
            endif

            assign tag = 'div'
            if link != blank
              assign tag = 'a'
            endif

            assign image_fit_class = 'fctr-banner-duo__img fctr-banner-duo__img--' | append: section.settings.image_fit
          -%}

          {%- if banner_has_content -%}
            <{{ tag }}
              class="fctr-banner-duo__banner"
              {% if tag == 'a' %}href="{{ link }}"{% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="fctr-banner-duo__media">
                {%- if image != blank -%}
                  {{ image | image_url: width: 2200 | image_tag:
                    class: image_fit_class,
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    alt: title | default: 'Banner'
                  }}
                {%- else -%}
                  <div class="fctr-banner-duo__placeholder"></div>
                {%- endif -%}
                <div class="fctr-banner-duo__overlay"></div>
              </div>

              <div class="fctr-banner-duo__content">
                {%- if subtitle != '' -%}
                  <div class="fctr-banner-duo__subtitle">{{ subtitle }}</div>
                {%- endif -%}
                {%- if title != '' -%}
                  <div class="fctr-banner-duo__title">{{ title }}</div>
                {%- endif -%}

                {%- if section.settings.show_cta and link != blank -%}
                  <span class="fctr-banner-duo__cta">{{ block.settings.link_text }}</span>
                {%- endif -%}
              </div>
            </{{ tag }}>
          {%- endif -%}

        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  .fctr-banner-duo { width: 100%; }

  .fctr-banner-duo__outer {
    padding-top: var(--fctr-pad-top);
    padding-bottom: var(--fctr-pad-bottom);
    padding-left: var(--fctr-pad-x);
    padding-right: var(--fctr-pad-x);
  }

  .fctr-banner-duo__inner--contained {
    max-width: var(--fctr-max-width);
    margin: 0 auto;
  }

  .fctr-banner-duo__heading {
    margin: 0 0 18px 0;
    font-size: 28px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .fctr-banner-duo__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--fctr-gap);
  }

  @media (max-width: 600px) {
    .fctr-banner-duo__grid { grid-template-columns: 1fr; }
  }

  .fctr-banner-duo__banner {
    position: relative;
    display: block;
    min-height: var(--fctr-min-height);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .fctr-banner-duo__media {
    position: absolute;
    inset: 0;
  }

  .fctr-banner-duo__img,
  .fctr-banner-duo__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    transform: scale(1);
    transition: transform 0.3s ease;
  }

  .fctr-banner-duo__img--cover {
    object-fit: cover;
  }

  .fctr-banner-duo__img--contain {
    object-fit: contain;
  }

  .fctr-banner-duo__img--fill {
    object-fit: fill;
  }

  .fctr-banner-duo__img--adapt {
    width: 100%;
    height: auto;
    object-fit: unset;
  }

  .fctr-banner-duo__placeholder {
    background: #e9e9e9;
    object-fit: cover;
  }

  .fctr-banner-duo__overlay {
    position: absolute;
    inset: 0;
    background: var(--fctr-overlay-color);
    opacity: var(--fctr-overlay-opacity);
    transition: opacity 0.25s ease;
  }

  .fctr-banner-duo__content {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 2;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .fctr-banner-duo__subtitle {
    font-size: 14px;
    opacity: 0.9;
    margin-bottom: 4px;
  }

  .fctr-banner-duo__title {
    font-size: 32px;
    font-weight: 800;
    line-height: 1.1;
    margin: 0;
  }

  .fctr-banner-duo__cta {
    display: inline-block;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 12px 18px;
    background: #fff;
    color: #000;
  }

  @media (hover: hover) {
    .fctr-banner-duo__banner:hover .fctr-banner-duo__overlay {
      opacity: calc(var(--fctr-overlay-opacity) + 0.15);
    }

    .fctr-banner-duo__banner:hover .fctr-banner-duo__img:not(.fctr-banner-duo__img--adapt) {
      transform: scale(1.03);
    }
  }
</style>

{%- endif -%}

{% schema %}
{
  "name": "Team banner duo",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "none" },

    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "contained",
      "options": [
        { "value": "contained", "label": "Contained" },
        { "value": "full", "label": "Full width" }
      ]
    },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 900, "max": 1800, "step": 20, "default": 1200 },
    { "type": "range", "id": "padding_x", "label": "Horizontal padding (px)", "min": 0, "max": 80, "step": 4, "default": 20 },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 120, "step": 4, "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 120, "step": 4, "default": 0 },

    {
      "type": "metaobject",
      "id": "team_metaobject",
      "label": "Team metaobject",
      "metaobject_type": "team",
      "info": "Optional. If your theme already exposes a global `team` object, leave blank."
    },

    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity (%)", "min": 0, "max": 100, "step": 5, "default": 40 },
    { "type": "range", "id": "gap", "label": "Tile gap (px)", "min": 0, "max": 40, "step": 2, "default": 12 },
    { "type": "range", "id": "min_height", "label": "Min tile height (px)", "min": 220, "max": 700, "step": 10, "default": 420 },

    {
      "type": "select",
      "id": "image_fit",
      "label": "Image display",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "fill", "label": "Fill" },
        { "value": "adapt", "label": "Adapt to image" }
      ]
    },

    { "type": "checkbox", "id": "show_cta", "label": "Show CTA button text", "default": true }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (static fallback)" },
        { "type": "text", "id": "team_image_field", "label": "Team image field key", "default": "none", "info": "Example: drive_image (image/file field on Team metaobject)" },

        { "type": "text", "id": "title", "label": "Title (static fallback)", "default": "Category" },
        { "type": "text", "id": "team_title_field", "label": "Team title field key", "default": "none", "info": "Optional: dynamic title field on Team metaobject" },

        { "type": "text", "id": "subtitle", "label": "Subtitle (static fallback)", "default": "none" },
        { "type": "text", "id": "team_subtitle_field", "label": "Team subtitle field key", "default": "none", "info": "Optional: dynamic subtitle field on Team metaobject" },

        { "type": "url", "id": "link", "label": "Link (static fallback)" },
        { "type": "text", "id": "team_link_field", "label": "Team link field key", "default": "none", "info": "Optional: dynamic link field on Team metaobject" },

        { "type": "text", "id": "link_text", "label": "CTA text", "default": "Shop" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Team banner duo",
      "blocks": [
        { "type": "banner", "settings": { "title": "Relentless Drive", "subtitle": "G.T. Cut 4", "link_text": "Shop" } },
        { "type": "banner", "settings": { "title": "Denim on Lock", "subtitle": "Nike Kids", "link_text": "Shop" } }
      ]
    }
  ]
}
{% endschema %}