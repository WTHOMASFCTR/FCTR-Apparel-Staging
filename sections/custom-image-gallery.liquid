{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gallery-{{ ai_gen_id }} {
    width: 100%;
    padding: 40px 20px;
  }

  .ai-gallery-inner-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-gallery-title-{{ ai_gen_id }} {
    margin: 0 0 30px;
    text-align: {{ section.settings.title_alignment }};
    color: {{ settings.heading_color }};
    {% if settings.heading_text_transform != blank %}
      text-transform: {{ settings.heading_text_transform }};
    {% endif %}
  }

  .ai-gallery-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.images_per_row }}, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
    align-items: start;
  }

  .ai-gallery-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ settings.block_border_radius | default: 0 }}px;
  }

  .ai-gallery-item-link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .ai-gallery-item-inner-{{ ai_gen_id }} {
    display: block;
  }

  .ai-gallery-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
  }

  .ai-gallery-image-wrapper-{{ ai_gen_id }}.aspect-square {
    aspect-ratio: 1 / 1;
  }

  .ai-gallery-image-wrapper-{{ ai_gen_id }}.aspect-portrait {
    aspect-ratio: 3 / 4;
  }

  .ai-gallery-image-wrapper-{{ ai_gen_id }}.aspect-horizontal {
    aspect-ratio: 4 / 3;
  }

  .ai-gallery-image-wrapper-{{ ai_gen_id }}.aspect-natural {
    aspect-ratio: auto;
  }

  .ai-gallery-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-gallery-image-{{ ai_gen_id }}.fit-cover,
  .ai-gallery-image-{{ ai_gen_id }}.fit-contain,
  .ai-gallery-image-{{ ai_gen_id }}.fit-fill {
    width: 100%;
    height: 100%;
  }

  .ai-gallery-image-{{ ai_gen_id }}.fit-cover {
    object-fit: cover;
  }

  .ai-gallery-image-{{ ai_gen_id }}.fit-contain {
    object-fit: contain;
  }

  .ai-gallery-image-{{ ai_gen_id }}.fit-fill {
    object-fit: fill;
  }

  .ai-gallery-image-{{ ai_gen_id }}.fit-adapt {
    width: 100%;
    height: auto;
    object-fit: unset;
  }

  .ai-gallery-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    min-height: 220px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-gallery-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-gallery-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity }};
    pointer-events: none;
    z-index: 1;
  }

  .ai-gallery-caption-{{ ai_gen_id }} {
    margin: 0;
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-weight: {{ settings.heading_font.weight }};
    font-style: {{ settings.heading_font.style }};
    {% if settings.heading_text_transform != blank %}
      text-transform: {{ settings.heading_text_transform }};
    {% endif %}
    line-height: 1.2;
  }

  .ai-gallery-caption-{{ ai_gen_id }}.caption-on-image {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    color: #ffffff;
    z-index: 2;
  }

  .ai-gallery-caption-{{ ai_gen_id }}.caption-underneath {
    padding: 15px 0 0;
    color: {{ settings.heading_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-gallery-grid-{{ ai_gen_id }} {
      {% if section.settings.mobile_layout == 'stack' %}
        grid-template-columns: 1fr;
      {% elsif section.settings.mobile_layout == 'carousel' %}
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: {{ section.settings.gap }}px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      {% endif %}
    }

    .ai-gallery-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    {% if section.settings.mobile_layout == 'carousel' %}
      .ai-gallery-item-{{ ai_gen_id }} {
        flex: 0 0 85%;
        scroll-snap-align: start;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-gallery-{{ ai_gen_id }}">
  <div class="ai-gallery-inner-{{ ai_gen_id }}">
    {% if section.settings.gallery_title != blank %}
      <h2 class="ai-gallery-title-{{ ai_gen_id }} heading h2">{{ section.settings.gallery_title }}</h2>
    {% endif %}

    <div class="ai-gallery-grid-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign caption_key = 'caption_' | append: i %}
        {% assign link_key = 'link_' | append: i %}

        {% assign current_image = section.settings[image_key] %}
        {% assign current_caption = section.settings[caption_key] %}
        {% assign current_link = section.settings[link_key] %}

        {% if i <= section.settings.number_of_images %}
          <div class="ai-gallery-item-{{ ai_gen_id }}">
            {% if current_link != blank %}
              <a href="{{ current_link }}" class="ai-gallery-item-link-{{ ai_gen_id }}">
            {% else %}
              <div class="ai-gallery-item-inner-{{ ai_gen_id }}">
            {% endif %}

              <div class="ai-gallery-image-wrapper-{{ ai_gen_id }} aspect-{{ section.settings.image_aspect_ratio }}">
                {% if current_image != blank %}
                  {% assign image_classes = 'ai-gallery-image-' | append: ai_gen_id | append: ' fit-' | append: section.settings.image_fit %}
                  {{
                    current_image
                    | image_url: width: 1600
                    | image_tag:
                      class: image_classes,
                      loading: 'lazy',
                      widths: '320, 480, 640, 800, 960, 1200, 1600',
                      sizes: '(max-width: 749px) 85vw, 100vw'
                  }}
                {% else %}
                  <div class="ai-gallery-image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if section.settings.show_overlay %}
                  <div class="ai-gallery-overlay-{{ ai_gen_id }}"></div>
                {% endif %}

                {% if current_caption != blank and section.settings.caption_position == 'on_image' %}
                  <h4 class="ai-gallery-caption-{{ ai_gen_id }} caption-on-image">{{ current_caption }}</h4>
                {% endif %}
              </div>

              {% if current_caption != blank and section.settings.caption_position == 'underneath' %}
                <h4 class="ai-gallery-caption-{{ ai_gen_id }} caption-underneath">{{ current_caption }}</h4>
              {% endif %}

            {% if current_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom image gallery",
  "tag": "section",
  "class": "section section-custom-image-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Gallery settings"
    },
    {
      "type": "text",
      "id": "gallery_title",
      "label": "Gallery title"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "number_of_images",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Number of images",
      "default": 3
    },
    {
      "type": "range",
      "id": "images_per_row",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Images per row",
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Gap between images",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image shape",
      "options": [
        { "value": "natural", "label": "Adapt to image" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "horizontal", "label": "Horizontal" }
      ],
      "default": "natural"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image display",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "caption_position",
      "label": "Caption position",
      "options": [
        { "value": "on_image", "label": "On image" },
        { "value": "underneath", "label": "Underneath" }
      ],
      "default": "underneath"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Overlay opacity",
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "stack", "label": "Stack" },
        { "value": "carousel", "label": "Scrollable carousel" }
      ],
      "default": "stack"
    },
    {
      "type": "header",
      "content": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption_1",
      "label": "Caption"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption_2",
      "label": "Caption"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption_3",
      "label": "Caption"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption_4",
      "label": "Caption"
    },
    {
      "type": "url",
      "id": "link_4",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image 5"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption_5",
      "label": "Caption"
    },
    {
      "type": "url",
      "id": "link_5",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Custom image gallery"
    }
  ]
}
{% endschema %}