{%- assign collection_sort_by = collection.sort_by | default: collection.default_sort_by -%}
{%- assign active_filters_count = 0 -%}

{%- for filter in collection.filters -%}
  {%- if filter.type == 'list' -%}
    {%- assign active_filters_count = active_filters_count | plus: filter.active_values.size -%}
  {%- elsif filter.type == 'price_range' -%}
    {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
      {%- assign active_filters_count = active_filters_count | plus: 1 -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- assign quick_pills_source_label_normalized = section.settings.quick_pills_source_filter_label | strip | downcase -%}
{%- assign quick_pills_trigger_label_normalized = section.settings.quick_pills_trigger_filter_label | strip | downcase -%}
{%- assign quick_pills_show = false -%}
{%- assign quick_pills_has_values = false -%}
{%- assign quick_pills_trigger_is_active = false -%}

{%- if section.settings.show_quick_filter_pills and collection.filters != empty -%}
  {%- for filter in collection.filters -%}
    {%- assign filter_label_normalized = filter.label | strip | downcase -%}

    {%- if quick_pills_source_label_normalized != blank and filter_label_normalized == quick_pills_source_label_normalized -%}
      {%- if filter.type == 'list' and filter.values.size > 0 -%}
        {%- assign quick_pills_has_values = true -%}
      {%- endif -%}
    {%- endif -%}

    {%- if quick_pills_trigger_label_normalized != blank and filter_label_normalized == quick_pills_trigger_label_normalized -%}
      {%- if filter.type == 'list' and filter.active_values.size > 0 -%}
        {%- assign quick_pills_trigger_is_active = true -%}
      {%- elsif filter.type == 'price_range' -%}
        {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
          {%- assign quick_pills_trigger_is_active = true -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if quick_pills_has_values -%}
    {%- if section.settings.quick_pills_only_show_when_trigger_active -%}
      {%- if quick_pills_trigger_is_active -%}
        {%- assign quick_pills_show = true -%}
      {%- endif -%}
    {%- else -%}
      {%- assign quick_pills_show = true -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} {
    --section-products-per-row: {{ section.settings.mobile_products_per_row | times: 1 }};
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} {
      {%- assign remainder_for_two = section.settings.products_per_page | modulo: 2 -%}
      {%- assign remainder_for_desktop_count = section.settings.products_per_page | modulo: section.settings.desktop_products_per_row -%}

      --section-products-per-row: {% if remainder_for_two == 0 and remainder_for_desktop_count == 0 %}2{% else %}3{% endif %};
    }
  }

  {%- if section.settings.filter_position == 'drawer' -%}
    @media screen and (min-width: 1200px) {
      #shopify-section-{{ section.id }} {
        --section-products-per-row: {{ section.settings.desktop_products_per_row }};
      }
    }
  {%- else -%}
    @media screen and (min-width: 1400px) {
      #shopify-section-{{ section.id }} {
        --section-products-per-row: {{ section.settings.desktop_products_per_row }};
      }
    }
  {%- endif -%}

  {%- for block in section.blocks -%}
    #block-{{ section.id }}-{{ block.id }} {
      --heading-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
      --text-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
      --section-block-background: {{ block.settings.background.red }}, {{ block.settings.background.green }}, {{ block.settings.background.blue }};
      --primary-button-background: {{ block.settings.button_background.red }}, {{ block.settings.button_background.green }}, {{ block.settings.button_background.blue }};
      --primary-button-text-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};

      {%- assign text_position = block.settings.text_position | split: '_' | first -%}

      {%- case text_position -%}
        {%- when 'top' -%}
          {%- assign section_items_alignment = 'flex-start' -%}
        {%- when 'middle' -%}
          {%- assign section_items_alignment = 'center' -%}
        {%- when 'bottom' -%}
          {%- assign section_items_alignment = 'flex-end' -%}
      {%- endcase -%}

      --section-blocks-alignment: {{ section_items_alignment }};
    }
  {%- endfor -%}

  {%- if section.settings.show_filters and collection.filters != empty and collection.products_count > 0 -%}
    .mobile-toolbar__item--filters {
      display: flex !important;
    }
  {%- endif -%}

  {%- if section.settings.show_sort_by and collection.products_count > 0 -%}
    .mobile-toolbar__item--sort {
      display: flex !important;
    }
  {%- endif -%}

  {%- if section.settings.show_sort_by or section.settings.show_filters and collection.filters != empty -%}
    @media screen and (max-width: 999px) {
      :root {
        --anchor-offset: 60px;
      }
    }
  {%- endif -%}

  .collection-quick-pills {
    margin: 0 0 24px;
    position: relative;
    z-index: 2;
  }

  .collection-quick-pills__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .collection-quick-pills__title {
    width: 100%;
    margin: 0 0 4px;
  }

  .collection-quick-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 10px 18px;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid rgb(var(--text-color) / 0.08);
    background: {{ section.settings.quick_pills_background }};
    color: {{ section.settings.quick_pills_text_color }};
    transition: background .2s ease, color .2s ease, border-color .2s ease, opacity .2s ease;
    line-height: 1;
    white-space: nowrap;
    position: relative;
    z-index: 2;
    pointer-events: auto;
    cursor: pointer;
  }

  .collection-quick-pill:hover {
    opacity: 0.9;
  }

  .collection-quick-pill.is-active {
    background: {{ section.settings.quick_pills_active_background }};
    color: {{ section.settings.quick_pills_active_text_color }};
    border-color: {{ section.settings.quick_pills_active_background }};
  }

  .collection-quick-pill__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .collection-quick-pill__count {
    opacity: 0.75;
    font-size: 0.9em;
  }

  .collection-pagination {
    margin-top: 36px;
  }

  .collection-pagination__arrows {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 20px;
  }

  .collection-pagination--arrows .collection-pagination__arrows {
    margin-top: 0;
  }

  .collection-infinite-scroll {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 36px;
    min-height: 48px;
  }

  .collection-infinite-scroll__status {
    margin: 0;
  }

  .collection-infinite-scroll__button.is-loading {
    opacity: 0.65;
    pointer-events: none;
  }

  @media screen and (max-width: 740px) {
    .collection-quick-pills {
      margin: 0 0 18px;
    }

    .collection-quick-pills__inner {
      gap: 10px;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
      scrollbar-width: none;
    }

    .collection-quick-pills__inner::-webkit-scrollbar {
      display: none;
    }

    .collection-quick-pill {
      flex: 0 0 auto;
      min-height: 40px;
      padding: 10px 16px;
    }

    .collection-pagination__arrows {
      gap: 10px;
    }
  }
</style>

<section>
  <div class="container">
    {%- if collection.products_count > 0 -%}
      <div id="mobile-facet-toolbar" class="mobile-toolbar hidden-lap-and-up">
        <button
          is="toggle-button"
          class="mobile-toolbar__item mobile-toolbar__item--filters {% if active_filters_count > 0 %}has-filters{% endif %}"
          aria-expanded="false"
          aria-controls="facet-filters"
          style="display: none"
        >
          {%- render 'icon' with 'filters' -%}
          <span class="mobile-toolbar__item-label">{{- 'collection.general.filters' | t -}}</span>
        </button>

        <button
          is="toggle-button"
          class="mobile-toolbar__item mobile-toolbar__item--sort"
          aria-expanded="false"
          aria-controls="sort-by-popover"
          style="display: none"
        >
          <span class="mobile-toolbar__item-label">{{- 'collection.general.sort_by' | t -}}</span>
          {%- render 'icon' with 'chevron' -%}
        </button>
      </div>
    {%- endif -%}

    <product-facet section-id="{{ section.id }}" class="product-facet">
      {%- if section.settings.show_filters and collection.filters != empty -%}
        {%- if section.settings.filter_position == 'always_visible' -%}
          <div class="product-facet__aside">
            <safe-sticky offset="30" class="product-facet__aside-inner">
              <div class="product-facet__filters-header hidden-pocket">
                <p class="heading {% if settings.heading_text_transform == 'uppercase' %}h6{% else %}h5{% endif %}">{{ 'collection.general.filters' | t }}</p>
              </div>

              {%- render 'facet-filters', filters: collection.filters, filters_position: section.settings.filter_position -%}
            </safe-sticky>
          </div>
        {%- else -%}
          {%- render 'facet-filters', filters: collection.filters, filters_position: section.settings.filter_position -%}
        {%- endif -%}
      {%- endif -%}

      <div id="facet-main" class="product-facet__main anchor" role="region" aria-live="polite">
        {%- if section.blocks.size > 0 -%}
          {%- capture promotion_blocks -%}
            <div class="promotion-block-list promotion-block-list--{{ section.settings.promotion_position }}">
              {%- for block in section.blocks -%}
                {%- capture block_content -%}
                  {%- if block.settings.image != blank -%}
                    {%- capture sizes_attribute -%}(max-width: 740px) calc(100vw - 12px * 2), calc(min(100vw, 1560px) / {{ section.blocks.size }} - 20px * {{ section.blocks.size | minus: 1 }}){%- endcapture -%}
                    {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: '200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500,1600', class: 'promotion-block__image' -}}
                  {%- endif -%}

                  <div class="promotion-block__content-wrapper text-container" style="{% if block.settings.text_position contains 'center' %}text-align: center{% elsif block.settings.text_position contains 'right' %}text-align: end{% endif %}">
                    {%- if block.settings.subheading != blank -%}
                      <p class="heading heading--small">{{ block.settings.subheading | escape }}</p>
                    {%- endif -%}

                    {%- if block.settings.title != blank -%}
                      <p class="heading h4">{{ block.settings.title | escape | newline_to_br }}</p>
                    {%- endif -%}

                    {%- if block.settings.link_text != blank -%}
                      {%- if block.settings.link_style == 'link' -%}
                        <span class="heading heading--small link">{{ block.settings.link_text | escape }}</span>
                      {%- else -%}
                        <div class="button-wrapper">
                          <span class="button button--small button--primary">{{ block.settings.link_text | escape }}</span>
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                {%- endcapture -%}

                {%- if block.settings.link_url != blank -%}
                  <a id="block-{{ section.id }}-{{ block.id }}" href="{{ block.settings.link_url }}" class="promotion-block promotion-block--{{ section.settings.promotion_height }} promotion-block--expand image-zoom" {{ block.shopify_attributes }}>
                    {{- block_content -}}
                  </a>
                {%- else -%}
                  <div id="block-{{ section.id }}-{{ block.id }}" class="promotion-block promotion-block--{{ section.settings.promotion_height }} promotion-block--expand image-zoom" {{ block.shopify_attributes }}>
                    {{- block_content -}}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endcapture -%}
        {%- endif -%}

        {%- if section.settings.promotion_position == 'top' -%}
          {{- promotion_blocks -}}
        {%- endif -%}

        {%- if collection.products_count > 0 -%}
          <div class="product-facet__meta-bar anchor">
            {%- if section.settings.filter_position == 'drawer' and section.settings.show_filters and collection.filters != empty -%}
              <button type="submit" is="toggle-button" class="product-facet__meta-bar-item product-facet__meta-bar-item--filter hidden-pocket" aria-controls="facet-filters" aria-expanded="false">
                {%- render 'icon' with 'filters', inline: true -%} {{- 'collection.general.show_filters' | t -}} {% if active_filters_count > 0 %}<span class="product-facet__active-count bubble-count">{{ active_filters_count }}</span>{% endif %}
              </button>
            {%- endif -%}

            <span class="product-facet__meta-bar-item product-facet__meta-bar-item--count" role="status">{{ 'collection.general.products_count' | t: count: collection.products_count }}</span>

            {%- if section.settings.show_sort_by -%}
              <div class="product-facet__meta-bar-item product-facet__meta-bar-item--sort">
                <span class="product-facet__sort-by-title text--subdued hidden-pocket">{{ 'collection.general.sort_by' | t }}</span>

                <div class="popover-container">
                  {%- for option in collection.sort_options -%}
                    {%- if option.value == collection_sort_by -%}
                      {%- assign collection_sort_by_name = option.name -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}

                  <button type="button" is="toggle-button" class="popover-button hidden-pocket" aria-expanded="false" aria-controls="sort-by-popover">
                    <span id="sort-by-selected-value" style="pointer-events: none">{{- collection_sort_by_name -}}</span>
                    {%- render 'icon' with 'chevron', inline: true -%}
                  </button>

                  <sort-by-popover id="sort-by-popover" class="popover">
                    <span class="popover__overlay"></span>

                    <header class="popover__header">
                      <span class="popover__title heading h6">{{- 'collection.general.sort_by' | t -}}</span>

                      <button type="button" class="popover__close-button tap-area tap-area--large" data-action="close" title="{{ 'general.accessibility.close' | t | escape }}">
                        {%- render 'icon' with 'close' -%}
                      </button>
                    </header>

                    <div class="popover__content">
                      <div class="popover__choice-list">
                        {%- for sort_option in collection.sort_options -%}
                          <label class="popover__choice-item">
                            <input type="radio" data-bind-value="sort-by-selected-value" class="visually-hidden" {% if sort_option.value == collection_sort_by %}checked="checked"{% endif %} name="sort_by" value="{{ sort_option.value }}" title="{{ sort_option.name }}">
                            <span class="popover__choice-label">{{ sort_option.name }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </div>
                  </sort-by-popover>
                </div>
              </div>
            {%- endif -%}
          </div>

          {%- if quick_pills_show -%}
            <div class="collection-quick-pills">
              {%- if section.settings.quick_pills_heading != blank -%}
                <p class="collection-quick-pills__title heading heading--small">{{ section.settings.quick_pills_heading | escape }}</p>
              {%- endif -%}

              <div class="collection-quick-pills__inner">
                {%- for filter in collection.filters -%}
                  {%- assign filter_label_normalized = filter.label | strip | downcase -%}

                  {%- if filter_label_normalized == quick_pills_source_label_normalized and filter.type == 'list' -%}
                    {%- for value in filter.values -%}
                      {%- if value.count > 0 or value.active -%}
                        <a
                          href="{% if value.active %}{{ value.url_to_remove | default: value.url }}{% else %}{{ value.url_to_add | default: value.url }}{% endif %}"
                          class="collection-quick-pill heading heading--small {% if value.active %}is-active{% endif %}"
                          data-quick-pill
                        >
                          <span class="collection-quick-pill__label">
                            <span>{{ value.label }}</span>

                            {%- if section.settings.show_quick_pills_count -%}
                              <span class="collection-quick-pill__count">{{ value.count }}</span>
                            {%- endif -%}
                          </span>
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- if active_filters_count > 0 -%}
            <div class="product-facet__active-list tag-list hidden-tablet-and-up">
              {%- render 'facet-active-filters', filters: collection.filters -%}
            </div>
          {%- endif -%}

          {%- paginate collection.products by section.settings.products_per_page -%}
            <product-list id="InfiniteCollectionProductList-{{ section.id }}" {% if settings.stagger_products_apparition and section.settings.enable_infinite_scroll == false %}stagger-apparition{% endif %} class="product-facet__product-list product-list anchor" data-infinite-product-list>
              {%- if section.settings.filter_position == 'always_visible' and section.settings.show_filters and collection.filters != empty -%}
                {%- assign sidebar_width = 305 -%}
              {%- else -%}
                {%- assign sidebar_width = 0 -%}
              {%- endif -%}

              <div class="product-list__inner" data-infinite-product-grid>
                {%- assign desktop_number_of_products_minus_one = section.settings.desktop_products_per_row | minus: 1 -%}
                {%- assign gap_width = 24.0 | divided_by: section.settings.desktop_products_per_row | times: desktop_number_of_products_minus_one -%}
                {%- capture sizes_attribute -%}(max-width: 740px) calc({{ 100.0 | divided_by: section.settings.mobile_products_per_row | ceil }}vw - 24px), calc((min(100vw - 80px, 1520px) - {{ sidebar_width }}px) / {{ section.settings.desktop_products_per_row }} - {{ gap_width | ceil }}px){%- endcapture -%}

                {%- assign product_item_reveal = settings.stagger_products_apparition -%}
                {%- if section.settings.enable_infinite_scroll -%}
                  {%- assign product_item_reveal = false -%}
                {%- endif -%}

                {%- for product in collection.products -%}
                  {%- render 'product-item', product: product, collection: collection, sizes_attribute: sizes_attribute, reveal: product_item_reveal -%}
                {%- endfor -%}
              </div>
            </product-list>

            {%- if section.settings.enable_infinite_scroll -%}
              {%- if paginate.next -%}
                <div class="collection-infinite-scroll" data-infinite-scroll-wrapper>
                  <a href="{{ paginate.next.url }}" class="button button--secondary collection-infinite-scroll__button" data-infinite-next>
                    Load more products
                  </a>

                  <p class="collection-infinite-scroll__status text--subdued" data-infinite-status hidden>
                    Loading more products...
                  </p>
                </div>
              {%- endif -%}
            {%- elsif section.settings.pagination_style != 'none' -%}
              <div class="collection-pagination collection-pagination--{{ section.settings.pagination_style }}">
                {%- if section.settings.pagination_style == 'numbers' or section.settings.pagination_style == 'both' -%}
                  {%- render 'pagination', paginate: paginate, use_ajax: true -%}
                {%- endif -%}

                {%- if section.settings.pagination_style == 'arrows' or section.settings.pagination_style == 'both' -%}
                  <div class="collection-pagination__arrows">
                    {%- if paginate.previous -%}
                      <a href="{{ paginate.previous.url }}" class="button button--secondary">
                        ← Previous
                      </a>
                    {%- endif -%}

                    {%- if paginate.next -%}
                      <a href="{{ paginate.next.url }}" class="button button--secondary">
                        Next →
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endpaginate -%}

          {%- if section.settings.promotion_position == 'bottom' -%}
            {{- promotion_blocks -}}
          {%- endif -%}
        {%- else -%}
          <div class="empty-state">
            {%- if collection.all_products_count == 0 -%}
              <h3 class="heading h4">{{ 'collection.general.empty_title' | t }}</h3>
              <p>{{ 'collection.general.empty_label' | t }}</p>

              <div class="button-wrapper">
                <a href="{{ routes.all_products_collection_url }}" class="button button--primary">{{ 'collection.general.empty_button' | t }}</a>
              </div>
            {%- else -%}
              <h3 class="heading h4">{{ 'collection.general.no_results_title' | t }}</h3>
              <p>{{ 'collection.general.no_results_label' | t }}</p>

              <div class="button-wrapper">
                <a href="{{ collection.url }}?sort_by={{ collection_sort_by }}" data-action="clear-filters" class="button button--primary">{{ 'collection.general.no_results_button' | t }}</a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </product-facet>
  </div>
</section>

<script>
  document.addEventListener('click', function(event) {
    const pill = event.target.closest('[data-quick-pill]');
    if (!pill) return;

    const href = pill.getAttribute('href');
    if (!href) return;

    event.preventDefault();
    window.location.href = href;
  });

  (function() {
    const sectionId = '{{ section.id }}';
    let observer = null;
    let scrollFallbackTimer = null;
    let loading = false;

    function getSection() {
      return document.getElementById('shopify-section-' + sectionId);
    }

    function getProductGrid(root) {
      if (!root) return null;

      return root.querySelector('[data-infinite-product-grid]') ||
        root.querySelector('#InfiniteCollectionProductList-' + sectionId + ' .product-list__inner') ||
        root.querySelector('.product-facet__product-list .product-list__inner') ||
        root.querySelector('.product-list__inner');
    }

    function getNextLink(root) {
      if (!root) return null;

      return root.querySelector('[data-infinite-next]') ||
        root.querySelector('.collection-infinite-scroll a[href*="page="]') ||
        root.querySelector('a[href*="page="][href*="collections"]');
    }

    function getWrapper(root) {
      if (!root) return null;

      return root.querySelector('[data-infinite-scroll-wrapper]') ||
        root.querySelector('.collection-infinite-scroll');
    }

    function getStatus(root) {
      if (!root) return null;

      return root.querySelector('[data-infinite-status]');
    }

    function makeSectionFetchUrl(nextUrl) {
      const url = new URL(nextUrl, window.location.origin);
      url.searchParams.set('section_id', sectionId);
      return url.toString();
    }

    function forceProductCardsVisible(container) {
      if (!container) return;

      const cards = container.querySelectorAll('[reveal], .product-item, product-item, .product-card, .product-list__item');

      cards.forEach(function(card) {
        card.removeAttribute('reveal');
        card.removeAttribute('hidden');
        card.style.opacity = '';
        card.style.transform = '';
        card.style.visibility = '';
        card.style.display = '';
      });
    }

    function setLoading(isLoading) {
      loading = isLoading;

      const section = getSection();
      const nextLink = getNextLink(section);
      const status = getStatus(section);

      if (nextLink) {
        nextLink.classList.toggle('is-loading', isLoading);
        nextLink.setAttribute('aria-busy', isLoading ? 'true' : 'false');
      }

      if (status) {
        status.hidden = !isLoading;
        status.textContent = 'Loading more products...';
      }
    }

    function getDistanceFromBottom() {
      return document.documentElement.scrollHeight - window.innerHeight - window.scrollY;
    }

    async function loadNextPage(event) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
        if (typeof event.stopImmediatePropagation === 'function') {
          event.stopImmediatePropagation();
        }
      }

      if (loading) return;

      const section = getSection();
      const productGrid = getProductGrid(section);
      const wrapper = getWrapper(section);
      const nextLink = getNextLink(section);
      const status = getStatus(section);

      if (!section || !productGrid || !nextLink) return;

      const nextUrl = nextLink.getAttribute('href');
      if (!nextUrl) return;

      setLoading(true);

      try {
        const response = await fetch(makeSectionFetchUrl(nextUrl), {
          credentials: 'same-origin',
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        });

        if (!response.ok) throw new Error('Could not load next collection section.');

        const html = await response.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');

        const nextPageGrid = getProductGrid(doc);
        const newNextLink = getNextLink(doc);

        if (!nextPageGrid) throw new Error('The next page did not contain a product grid.');

        const newProductCards = Array.from(nextPageGrid.children).filter(function(card) {
          return card && card.nodeType === 1;
        });

        if (!newProductCards.length) {
          if (wrapper) wrapper.remove();
          if (observer) observer.disconnect();
          window.removeEventListener('scroll', handleScrollFallback);
          return;
        }

        newProductCards.forEach(function(card) {
          card.removeAttribute('reveal');
          card.removeAttribute('hidden');
          card.style.opacity = '';
          card.style.transform = '';
          card.style.visibility = '';
          card.style.display = '';
          productGrid.appendChild(card);
        });

        forceProductCardsVisible(productGrid);

        if (newNextLink && newNextLink.getAttribute('href')) {
          nextLink.setAttribute('href', newNextLink.getAttribute('href'));
        } else {
          if (wrapper) wrapper.remove();
          if (observer) observer.disconnect();
          window.removeEventListener('scroll', handleScrollFallback);
        }

        document.dispatchEvent(new CustomEvent('collection:infinite-scroll:loaded', {
          detail: {
            sectionId: sectionId,
            url: nextUrl,
            addedProducts: newProductCards.length
          }
        }));
      } catch (error) {
        console.error('[Infinite collection scroll]', error);

        if (status) {
          status.hidden = false;
          status.textContent = 'Products could not be loaded automatically. Opening the next page instead...';
        }

        window.setTimeout(function() {
          window.location.href = nextUrl;
        }, 750);
      } finally {
        loading = false;

        const updatedSection = getSection();
        const updatedNextLink = getNextLink(updatedSection);
        const updatedStatus = getStatus(updatedSection);

        if (updatedNextLink) {
          updatedNextLink.classList.remove('is-loading');
          updatedNextLink.setAttribute('aria-busy', 'false');
        }

        if (updatedStatus && updatedStatus.textContent === 'Loading more products...') {
          updatedStatus.hidden = true;
        }
      }
    }

    function handleCapturedNextClick(event) {
      const link = event.target.closest('[data-infinite-next]');
      if (!link) return;
      loadNextPage(event);
    }

    function handleScrollFallback() {
      if (scrollFallbackTimer) return;

      scrollFallbackTimer = window.setTimeout(function() {
        scrollFallbackTimer = null;

        if (loading) return;

        const section = getSection();
        const nextLink = getNextLink(section);

        if (!nextLink) return;

        if (getDistanceFromBottom() < 1400) {
          loadNextPage();
        }
      }, 150);
    }

    function initInfiniteCollectionScroll() {
      const section = getSection();
      if (!section || section.dataset.infiniteScrollInitialized === 'true') return;

      const productGrid = getProductGrid(section);
      const wrapper = getWrapper(section);
      const nextLink = getNextLink(section);

      if (!productGrid || !wrapper || !nextLink) return;

      section.dataset.infiniteScrollInitialized = 'true';
      forceProductCardsVisible(productGrid);

      document.addEventListener('click', handleCapturedNextClick, true);

      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              loadNextPage();
            }
          });
        }, {
          root: null,
          rootMargin: '1200px 0px',
          threshold: 0
        });

        observer.observe(wrapper);
      }

      window.addEventListener('scroll', handleScrollFallback, { passive: true });
      handleScrollFallback();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initInfiniteCollectionScroll);
    } else {
      initInfiniteCollectionScroll();
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === sectionId) {
        const section = getSection();
        if (section) {
          delete section.dataset.infiniteScrollInitialized;
        }
        initInfiniteCollectionScroll();
      }
    });
  })();
</script>

